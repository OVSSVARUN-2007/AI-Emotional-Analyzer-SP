# =======================================================
# Sentio AI Assistant - Local LLM & Cloud Configuration
# =======================================================

# 1. LOCAL LLM SETUP (Ollama / LM Studio / vLLM / LocalAI)
# Ollama default: http://localhost:11434/api/generate
# LM Studio default: http://localhost:1234/v1/chat/completions
# vLLM default: http://localhost:8000/v1/chat/completions
LOCAL_LLM_URL=http://localhost:11434/api/generate

# The model name you downloaded locally (e.g. llama3, mistral, deepseek-r1:8b, phi3, gemma2)
LOCAL_LLM_MODEL=llama3

# Set to 'true' to use your Local LLM as the primary engine instead of cloud Gemini
PREFER_LOCAL_LLM=true

# Timeout in seconds for local inference (useful when running on CPU)
LOCAL_LLM_TIMEOUT=30.0

# 2. GOOGLE GEMINI CLOUD AI (Optional)
# Leave blank or comment out if you only want your Local LLM
# GEMINI_API_KEY=your_gemini_api_key_here
