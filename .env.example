# =======================================================
# Sentio AI Assistant - Local LLM & Cloud Configuration
# =======================================================

# 1. LOCAL LLM SETUP (Ollama / LM Studio / vLLM / LocalAI)
LOCAL_LLM_URL=http://localhost:11434/api/generate

# The model name downloaded locally on your machine
LOCAL_LLM_MODEL=llama3.2:1b

# Set to 'true' to use your Local LLM as the primary engine instead of cloud Gemini
PREFER_LOCAL_LLM=true

# Timeout in seconds for local inference on CPU
LOCAL_LLM_TIMEOUT=60.0

# 2. GOOGLE GEMINI CLOUD AI (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here